# Application Settings
APP_NAME="Your App Name"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Sendinblue Configuration (Email Service)
SENDINBLUE_API_KEY=your_sendinblue_api_key_here
SENDINBLUE_SMTP_KEY=your_sendinblue_smtp_key_here

# Stripe Configuration (Payment)
STRIPE_PUBLIC_KEY=pk_test_placeholder_here
STRIPE_SECRET_KEY=sk_test_placeholder_here
STRIPE_API_KEY=your_stripe_api_key_here

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Other Services
GOOGLE_API_KEY=your_google_api_key_here
FACEBOOK_APP_ID=your_facebook_app_id_here
